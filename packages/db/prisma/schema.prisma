generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  COMPANY_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum ProviderStatus {
  ONBOARDING
  VERIFIED
  ACTIVE
  PAUSED
  DORMANT
  BLOCKED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
  PAUSED
}

enum RequestStatus {
  CREATED
  MATCHING
  DISPATCHING
  WAITING_RESPONSES
  OFFERS_RECEIVED
  PROVIDER_SELECTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED_TO_MATCH
}

enum RequestUrgency {
  NOW
  TODAY
  SCHEDULED
  FLEXIBLE
}

enum CandidateStatus {
  ELIGIBLE
  DISPATCHED
  ACCEPTED
  DECLINED
  TIMED_OUT
  SKIPPED
}

enum DispatchResponse {
  ACCEPTED
  DECLINED
  TIMED_OUT
  CANCELLED
}

enum OfferStatus {
  PENDING
  SELECTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExceptionStatus {
  OPEN
  RESOLVED_AUTOMATICALLY
  RESOLVED_MANUALLY
  CLOSED
}

enum SupplyNeedStatus {
  OPEN
  WATCH
  RESOLVED
}

model User {
  id              String    @id @default(cuid())
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  email           String?   @unique
  name            String?
  role            UserRole  @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider Provider?
  requests Request[]
  orders   Order[]   @relation("CustomerOrders")
}

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers   Provider[]
  requests    Request[]
  supplyNeeds SupplyNeed[]
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  active      Boolean  @default(true)
  requestMode String   @default("DISPATCH")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    Service[]
  requests    Request[]
  supplyNeeds SupplyNeed[]
}

model Service {
  id         String   @id @default(cuid())
  categoryId String
  slug       String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerServices ProviderService[]
  requests         Request[]

  @@unique([categoryId, slug])
  @@index([categoryId, active])
}

model Provider {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  cityId                 String
  status                 ProviderStatus     @default(ONBOARDING)
  availability           AvailabilityStatus @default(OFFLINE)
  availableUntil         DateTime?
  onboardingCompletedAt  DateTime?
  serviceRadiusKm        Float              @default(10)
  latitude               Float?
  longitude              Float?
  responseRate           Float              @default(1)
  completionRate         Float              @default(1)
  rating                  Float              @default(5)
  reliabilityScore       Float              @default(0.5)
  activeJobs             Int                @default(0)
  consecutiveMisses      Int                @default(0)
  lastAvailabilityChange DateTime           @default(now())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  city             City              @relation(fields: [cityId], references: [id])
  services         ProviderService[]
  candidates       MatchCandidate[]
  dispatchAttempts DispatchAttempt[]
  offers           Offer[]
  orders           Order[]           @relation("ProviderOrders")

  @@index([cityId, status, availability])
  @@index([availability, availableUntil])
  @@index([reliabilityScore])
}

model ProviderService {
  providerId String
  serviceId  String
  active     Boolean @default(true)
  minPrice   Int?
  maxPrice   Int?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
  @@index([serviceId, active])
}

model Request {
  id                       String         @id @default(cuid())
  customerId               String
  cityId                   String
  categoryId               String
  serviceId                String?
  title                    String
  description              String?
  urgency                  RequestUrgency @default(TODAY)
  status                   RequestStatus  @default(CREATED)
  latitude                 Float?
  longitude                Float?
  maxDistanceKm            Float          @default(10)
  accessTokenHash          String?
  matchingRound            Int            @default(0)
  matchingWave             Int            @default(0)
  searchExpansionAttempted Boolean        @default(false)
  firstOfferAt             DateTime?
  matchedAt                DateTime?
  expiresAt                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  customer         User                  @relation(fields: [customerId], references: [id])
  city             City                  @relation(fields: [cityId], references: [id])
  category         Category              @relation(fields: [categoryId], references: [id])
  service          Service?              @relation(fields: [serviceId], references: [id])
  candidates       MatchCandidate[]
  dispatchAttempts DispatchAttempt[]
  offers           Offer[]
  order            Order?
  events           RequestEvent[]
  exceptions       AutomationException[]

  @@index([cityId, categoryId, status])
  @@index([status, createdAt])
}

model MatchCandidate {
  id         String          @id @default(cuid())
  requestId  String
  providerId String
  score      Float
  rank       Int
  status     CandidateStatus @default(ELIGIBLE)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([requestId, rank])
}

model DispatchAttempt {
  id          String            @id @default(cuid())
  requestId   String
  providerId  String
  round       Int               @default(0)
  wave        Int
  sentAt      DateTime          @default(now())
  expiresAt   DateTime
  viewedAt    DateTime?
  respondedAt DateTime?
  response    DispatchResponse?
  createdAt   DateTime          @default(now())

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([requestId, round, wave])
  @@index([expiresAt, response])
}

model Offer {
  id         String      @id @default(cuid())
  requestId  String
  providerId String
  amountKzt  Int?
  etaMinutes Int?
  comment    String?
  status     OfferStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  request  Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order    Order?

  @@unique([requestId, providerId])
  @@index([requestId, status])
}

model Order {
  id         String      @id @default(cuid())
  requestId  String      @unique
  offerId    String      @unique
  customerId String
  providerId String
  status     OrderStatus @default(CONFIRMED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  request  Request  @relation(fields: [requestId], references: [id])
  offer    Offer    @relation(fields: [offerId], references: [id])
  customer User     @relation("CustomerOrders", fields: [customerId], references: [id])
  provider Provider @relation("ProviderOrders", fields: [providerId], references: [id])

  @@index([providerId, status])
  @@index([customerId, createdAt])
}

model RequestEvent {
  id        String   @id @default(cuid())
  requestId String
  type      String
  source    String   @default("AUTOMATION")
  payload   Json?
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model AutomationException {
  id         String          @id @default(cuid())
  requestId  String
  code       String
  status     ExceptionStatus @default(OPEN)
  details    Json?
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model SupplyNeed {
  id              String           @id @default(cuid())
  cityId          String
  categoryId      String
  status          SupplyNeedStatus @default(OPEN)
  health          String
  targetAvailable Int
  availableNow    Int
  supplyGap       Int
  requests7d      Int
  priorityScore   Float
  lastEvaluatedAt DateTime         @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  city     City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cityId, categoryId])
  @@index([status, priorityScore])
  @@index([cityId, status, priorityScore])
}

model PhoneVerificationChallenge {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
